# PiChat 3.5 PERFORMANCE — exemple uniquement, aucune vraie clé ici.
# Sur Render, render.yaml fournit les variables principales automatiquement.

# PostgreSQL (laisser vide en local pour SQLite)
DATABASE_URL=

# Secret serveur long et aléatoire. NE JAMAIS le publier réellement.
PICHAT_SECRET_KEY=change-me-with-a-long-random-secret

PICHAT_SETUP_MODE=1
PICHAT_REGISTRATION_MODE=approval
PICHAT_INTERNET_MODE=1
PICHAT_COOKIE_SECURE=1
PICHAT_TRUST_PROXY=1
PICHAT_STORAGE_BACKEND=database
PICHAT_MAX_UPLOAD_MB=25

# URL publique facultative
PICHAT_PUBLIC_URL=

# Stockage S3-compatible facultatif
PICHAT_S3_BUCKET=
PICHAT_S3_ENDPOINT_URL=
PICHAT_S3_REGION=
PICHAT_S3_ACCESS_KEY_ID=
PICHAT_S3_SECRET_ACCESS_KEY=

# Compatibilité API IA historique facultative.
# Préférer Admin > Intégrations afin de stocker la clé côté serveur chiffrée.
OPENAI_API_KEY=
